    "## 16. Kompakte EDA-Zusammenfassung"
   ]
  },
  {
   "cell_type": "code",
   "id": "f9c0cbe6",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-07-31T20:46:48.460213918Z",
     "start_time": "2026-07-31T20:46:48.374500551Z"
    }
   },
   "source": [
    "primary_horizon = SETTINGS.targets.primary_horizon_candles\n",
    "primary_target = target_bundle.tables[\"target_balance\"]\n",
    "primary_target = primary_target.loc[\n",
    "    primary_target[\"horizon_candles\"] == primary_horizon\n",
    "]\n",
    "\n",
    "compact_summary = pd.DataFrame(\n",
    "    [\n",
    "        {\n",
    "            \"Kerzen\": len(eda_df),\n",
    "            \"Analysebeginn\": eda_df[\"open_time\"].min(),\n",
    "            \"Analyseende\": eda_df[\"open_time\"].max(),\n",
    "            \"Maximaler Drawdown\": drawdown_bundle.summary[\n",
    "                \"maximum_drawdown\"\n",
    "            ],\n",
    "            \"Aktuelle Volatilität\": volatility_bundle.summary[\n",
    "                \"current_volatility\"\n",
    "            ],\n",
    "            \"Mittlere Taker-Buy-Ratio\": volume_bundle.summary[\n",
    "                \"mean_taker_buy_ratio\"\n",
    "            ],\n",
    "            \"Primärer Targethorizont\": primary_horizon,\n",
    "            \"Targetklassen\": \", \".join(\n",
    "                f\"{row['class']}: {row['ratio']:.2%}\"\n",
    "                for _, row in primary_target.iterrows()\n",
    "            ),\n",
    "        }\n",
    "    ]\n",
    ")\n",
    "\n",
    "display(compact_summary.T.rename(columns={0: \"Wert\"}))"
