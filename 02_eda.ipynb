   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-07-31T20:43:21.415117653Z",
     "start_time": "2026-07-31T20:43:21.380201812Z"
    }
   },
   "source": [
    "def show_bundle_summary(bundle) -> None:\n",
    "    display(Markdown(f\"### Zusammenfassung: `{bundle.name}`\"))\n",
    "    display(pd.DataFrame([bundle.summary]))\n",
    "\n",
    "\n",
    "def show_bundle_tables(\n",
    "    bundle,\n",
    "    names: tuple[str, ...],\n",
    "    maximum_rows: int = 20,\n",
    ") -> None:\n",
    "    for name in names:\n",
    "        table = bundle.tables.get(name)\n",
    "        if table is None:\n",
    "            continue\n",
    "        display(Markdown(f\"#### Tabelle: `{name}`\"))\n",
    "        display(table.head(maximum_rows))\n",
    "\n",
    "\n",
    "def show_bundle_figures(\n",
    "    bundle,\n",
    "    names: tuple[str, ...],\n",
    ") -> None:\n",
    "    for name, figure in bundle.figures.items():\n",
    "        if name in names:\n",
    "            display(Markdown(f\"#### Abbildung: `{name}`\"))\n",
    "            display(figure)\n",
    "        plt.close(figure)"
   ],
   "outputs": [],
   "execution_count": 9
  },
