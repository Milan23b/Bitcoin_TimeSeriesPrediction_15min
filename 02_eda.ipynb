   "source": [
    "## 7. Renditen und Extremereignisse"
   ]
  },
  {
   "cell_type": "code",
   "id": "40ef099c",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-07-31T20:43:39.480840386Z",
     "start_time": "2026-07-31T20:43:34.920010210Z"
    }
   },
   "source": [
    "returns_bundle = analyze_returns(\n",
    "    enriched_df,\n",
    "    horizons=RETURN_HORIZONS,\n",
    "    extreme_count=30,\n",
    ")\n",
