   "source": [
    "# 02 – Explorative Datenanalyse\n",
    "\n",
    "Dieses Notebook ist die zweite Stufe der Analyse.\n",
    "\n",
    "Voraussetzung ist ein erfolgreiches `01_data_audit.ipynb`. Das Notebook\n",
    "untersucht die fachlichen und statistischen Eigenschaften des validierten\n",
    "BTCUSDT-15-Minuten-Datensatzes:\n",
    "\n",
    "- letzte Kerzen und deskriptive Statistik\n",
    "- Preisverlauf und Candlesticks\n",
    "- Renditeverteilungen und Extremereignisse\n",
    "- Volatilität\n",
    "- Volumen und Taker-Imbalance\n",
    "- UTC-Zeitmuster und Heatmaps\n",
    "- Korrelationen\n",
    "- Autokorrelation\n",
    "- Drawdowns\n",
    "- Marktregime\n",
    "- zukünftige Targetverteilungen\n",
    "\n",
    "Standardmäßig werden alle lokal vorhandenen Daten bis zur neuesten\n",
    "abgeschlossenen Kerze berücksichtigt."
   ]
  },
  {
   "cell_type": "code",
   "id": "e81a5cfa",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2026-07-31T20:42:55.655878296Z",
     "start_time": "2026-07-31T20:42:54.638191919Z"
    }
   },
   "source": [
    "from __future__ import annotations\n",
    "\n",
    "import sys\n",
    "from pathlib import Path\n",
    "\n",
    "from IPython import get_ipython\n",
    "from IPython.display import Markdown, display\n",
    "\n",
    "_ipython = get_ipython()\n",
    "if _ipython is not None:\n",
    "    _ipython.run_line_magic(\"matplotlib\", \"inline\")\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "pd.set_option(\"display.max_columns\", 100)\n",
    "pd.set_option(\"display.width\", 220)\n",
    "pd.set_option(\"display.float_format\", lambda value: f\"{value:,.6f}\")\n",
    "\n",
    "search_locations = [Path.cwd(), *Path.cwd().parents]\n",
    "PROJECT_ROOT = next(\n",
    "    (\n",
    "        path\n",
    "        for path in search_locations\n",
    "        if (path / \"eda.py\").exists()\n",
    "        and (path / \"data_quality.py\").exists()\n",
    "    ),\n",
    "    None,\n",
    ")\n",
    "\n",
    "if PROJECT_ROOT is None:\n",
    "    raise FileNotFoundError(\n",
    "        \"Projektwurzel nicht gefunden. Starte das Notebook im Projekt \"\n",
    "        \"oder in einem Unterordner mit eda.py und data_quality.py.\"\n",
    "    )\n",
    "\n",
    "if str(PROJECT_ROOT) not in sys.path:\n",
    "    sys.path.insert(0, str(PROJECT_ROOT))\n",
    "\n",
    "try:\n",
    "    from config import SETTINGS\n",
    "except ImportError:\n",
    "    from config_complete import SETTINGS\n",
    "\n",
    "from data_quality import DataQualityValidator\n",
    "from eda import (\n",
    "    analyze_autocorrelation,\n",
    "    analyze_drawdowns,\n",
    "    analyze_feature_correlations,\n",
    "    analyze_market_regimes,\n",
    "    analyze_price,\n",
    "    analyze_returns,\n",
    "    analyze_target_distributions,\n",
    "    analyze_temporal_patterns,\n",
    "    analyze_volume,\n",
    "    analyze_volatility,\n",
    "    calculate_calendar_features,\n",
    "    calculate_candle_features,\n",
    "    calculate_returns,\n",
    "    calculate_volume_features,\n",
    "    calculate_volatility_features,\n",
    "    create_dataset_overview,\n",
    "    load_canonical_data,\n",
    "    prepare_eda_frame,\n",
    "    run_eda,\n",
    ")\n",
    "\n",
    "print(f\"Projektwurzel: {PROJECT_ROOT}\")\n",
    "print(f\"Matplotlib-Backend: {plt.get_backend()}\")\n",
    "print(f\"Symbol / Intervall: {SETTINGS.market.symbol} / {SETTINGS.market.interval}\")"
   ],
